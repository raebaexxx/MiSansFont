<fonts-modification version="1">
  <!-- MiSans как системный шрифт. Начертания 1:1, а ползунок
       Settings.Secure.FONT_WEIGHT_ADJUSTMENT прибавляет к оси wght
       поверх них (см. service.sh / action.sh).
       sans-serif-condensed, sans-serif-monospace и sans-serif-smallcaps
       намеренно не тронуты: у MiSans нет оси wdth и нет моноширинного
       начертания, подмена там сломала бы их. -->
  <family customizationType="new-named-family" name="sans-serif-black">
    <font weight="700" style="normal">MiSansLatinVF.ttf
      <axis tag="wght" stylevalue="700"/>
    </font>
    <font weight="700" style="italic">MiSansLatinVF.ttf
      <axis tag="wght" stylevalue="700"/>
    </font>
  </family>
  <family customizationType="new-named-family" name="sans-serif-medium">
    <font weight="500" style="normal">MiSansLatinVF.ttf
      <axis tag="wght" stylevalue="500"/>
    </font>
    <font weight="500" style="italic">MiSansLatinVF.ttf
      <axis tag="wght" stylevalue="500"/>
    </font>
  </family>
  <family customizationType="new-named-family" name="sans-serif">
