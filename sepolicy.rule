# Подстраховка на случай, если chcon в customize.sh не сработал
# (например, SELinux-политика не даёт переменить контекст).
#
# Основная причина бутлупа была в том, что файлы модуля приходили с
# контекстом shell_data_file, и zygote не мог прочитать конфигурацию
# шрифтов. Если контекст всё же окажется не тем, разрешаем чтение.
allow zygote shell_data_file file { read open getattr map }
allow system_server shell_data_file file { read open getattr map }
allow zygote_file shell_data_file file { read open getattr map }
